{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lesepult",
  "version": "0.2.0",
  "identifier": "io.github.labrikg.lesepult",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lesepult",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false,
        "create": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/documents/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "files": {
        "Resources/Assets.car": "./icons/Assets.car"
      },
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "category": "Education",
    "shortDescription": "Notes, lecture PDFs and flashcards in one place",
    "longDescription": "Lesepult is a desktop study hub: notes in a block editor next to your lecture PDFs, highlights that link both ways, flashcards with spaced repetition, exams and to-dos per course, a Pomodoro timer and statistics.",
    "publisher": "Labrik Gashi",
    "copyright": "© 2026 Labrik Gashi. Licensed under the GPL-3.0.",
    "homepage": "https://github.com/labrikg/lesepult",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md"
    }
  }
}
